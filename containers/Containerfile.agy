# Thin image for the Antigravity CLI (agy) reviewer backend.
#
# Runs one headless `agy` per PR review inside an ephemeral container
# (`podman run --rm`) on the --agy-host, so agy never executes on the
# wrapper host that holds the ssh key and the provider API keys. The only
# model-reachable capability is the MCP shell into the review containers,
# via relay.py; that, mcp_shell_bridge.py, shell_bridge_client.py, the
# OAuth token, agy's settings and MCP config and the output schema are
# `podman cp`'d in per run (no bind mounts); the prompt goes in over the
# `podman exec -i` stdin. agy's own tools stay auto-denied (see
# agy_reviewer).
#
# The pinned agy binary (~220 MB) is NOT in git. Stage it into the build
# context before building:
#     cp /path/to/agy-X.Y.Z containers/agy                            # gitignored
#     python3 containers/provision_remote.py --ssh DEST --agy-bin containers/agy

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=C.UTF-8

# python3 runs mcp_shell_bridge.py + relay.py (copied in per run);
# ca-certificates lets agy reach Google's API over TLS. Unlike the
# review image, the model apt-installs nothing here, so the apt lists are
# dropped to keep the image lean.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The pinned binary, staged into the build context (see header).
COPY agy /usr/local/bin/
RUN chmod +x /usr/local/bin/agy

WORKDIR /work
CMD ["sleep", "infinity"]
