# Ephemeral developer environment for LLM-driven PR review.
# Built once, instantiated fresh per review (`podman run --rm`),
# destroyed afterwards. No host paths are bind-mounted here -- the
# wrapper copies the patched repo in at start-up and treats the
# container as untrusted for the rest of the review.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=C.UTF-8

# i386 multiarch must be enabled before any ``apt-get update`` so the
# ``:i386`` packages installed below resolve.  We use multiarch
# (``zlib1g-dev:i386`` etc.) for 32-bit support; we deliberately do
# NOT install ``gcc-multilib`` because it depends on
# ``libc6-dev-i386`` which conflicts with ``libc6:i386`` (multiarch).
# Use ``i686-linux-gnu-gcc`` for explicit 32-bit compilation instead.
# amd64 only: ports.ubuntu.com, which serves every non-x86 arch,
# carries no i386 (404 on its dists observed 2026-07-22), so adding
# the architecture fails the next ``apt-get update``.
RUN [ "$(dpkg --print-architecture)" != amd64 ] || dpkg --add-architecture i386

# Every install layer runs its own ``apt-get update``: layers rebuild
# independently (podman caches the unchanged ones), and an install
# re-run against another layer's months-old cached lists 404s on any
# package the archive has since replaced.

# Native toolchain, debuggers, sanitizer runtimes, and fuzzers.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential clang lld lldb gdb strace ltrace \
        clang-tools libclang-rt-dev \
        afl++

# Cross compilers.  ``gcc-i686-linux-gnu`` is the multiarch-friendly
# replacement for ``gcc-multilib`` (which conflicts with i386 dpkg
# multiarch).  qemu-user-static lets cross-built binaries run via
# explicit ``qemu-<arch> ./prog`` invocation; we don't rely on
# ``binfmt-support`` because /proc/sys/fs/binfmt_misc isn't
# generally writable inside an unprivileged container.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-i686-linux-gnu g++-i686-linux-gnu \
        gcc-aarch64-linux-gnu \
        gcc-arm-linux-gnueabihf gcc-arm-linux-gnueabi \
        gcc-mips-linux-gnu gcc-mipsel-linux-gnu \
        gcc-mips64-linux-gnuabi64 gcc-mips64el-linux-gnuabi64 \
        gcc-powerpc-linux-gnu gcc-powerpc64le-linux-gnu \
        gcc-riscv64-linux-gnu \
        qemu-user qemu-user-static

# 32-bit (i386) development libraries via dpkg multiarch (amd64 only,
# see the i386 note above).  Add more ``:i386`` packages here as
# concrete reviews require them.
RUN [ "$(dpkg --print-architecture)" != amd64 ] || \
    ( apt-get update && apt-get install -y --no-install-recommends \
        libc6-dev:i386 zlib1g-dev:i386 )

# Assemblers, build helpers, binary inspection.
RUN apt-get update && apt-get install -y --no-install-recommends \
        nasm yasm pkg-config binutils elfutils file ccache

# FFmpeg external libraries.  This is exactly Ubuntu 24.04's ffmpeg
# source-package Build-Depends set (minus ffmpeg's own libav*-dev and
# pure build tooling), so every entry is both a library FFmpeg's
# configure can ``--enable-`` and present in the 24.04 archive for
# both amd64 and arm64 (libvpl-dev, amd64-only, is in the per-arch
# layer below; libffmpeg-nvenc-dev is header-only, arch all).
RUN apt-get update && apt-get install -y --no-install-recommends \
        zlib1g-dev libbz2-dev liblzma-dev \
        libx264-dev libx265-dev libvpx-dev libaom-dev libdav1d-dev \
        librav1e-dev libsvtav1enc-dev libtheora-dev libxvidcore-dev \
        libwebp-dev libopenjp2-7-dev libjxl-dev libzimg-dev \
        libmp3lame-dev libopus-dev libvorbis-dev libspeex-dev \
        libtwolame-dev libshine-dev libgsm1-dev libcodec2-dev \
        libopencore-amrnb-dev libopencore-amrwb-dev libvo-amrwbenc-dev \
        libopenmpt-dev libgme-dev libbs2b-dev libmysofa-dev \
        libsoxr-dev librubberband-dev \
        libass-dev libfreetype-dev libfontconfig-dev libfribidi-dev \
        libharfbuzz-dev librsvg2-dev libzvbi-dev libaribb24-dev \
        libtesseract-dev \
        libbluray-dev libxml2-dev libsrt-gnutls-dev librist-dev \
        libssh-gcrypt-dev librabbitmq-dev libsmbclient-dev libsctp-dev \
        libzmq3-dev libsnappy-dev libchromaprint-dev libgnutls28-dev \
        libdc1394-dev libiec61883-dev libavc1394-dev libjack-jackd2-dev \
        libopenal-dev libpulse-dev libsdl2-dev libcaca-dev \
        libxcb-shape0-dev libxcb-shm0-dev libxcb-xfixes0-dev libxv-dev \
        libgl-dev \
        libva-dev libvdpau-dev libdrm-dev libvulkan-dev libplacebo-dev \
        libffmpeg-nvenc-dev ocl-icd-opencl-dev \
        libvidstab-dev frei0r-plugins-dev ladspa-sdk liblilv-dev \
        flite1-dev glslang-dev

# Per-arch packages.  noble/arm64 (ports.ubuntu.com, checked
# 2026-07-22) lacks gcc-powerpc64-linux-gnu (big-endian ppc64 cross)
# and libvpl-dev (Intel QSV); everything else in this file it carries.
# Off-amd64 the x86-64 cross fills the same role the aarch64 cross
# fills on amd64.
RUN if [ "$(dpkg --print-architecture)" = amd64 ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            gcc-powerpc64-linux-gnu libvpl-dev; \
    else \
        apt-get update && apt-get install -y --no-install-recommends \
            gcc-x86-64-linux-gnu g++-x86-64-linux-gnu; \
    fi

# CLI utilities and Python. The apt lists are deliberately kept (no
# ``rm -rf /var/lib/apt/lists``): the model apt-installs extra packages
# during reviews, and the ~80MB is noise next to the FATE layer below.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ripgrep fd-find jq curl wget rsync ca-certificates \
        unzip xz-utils zstd less procps \
        python3 python3-pip python3-venv \
        poppler-utils \
        nodejs npm

# ffmpeg-web build tooling: the site's Makefile runs ``lessc
# --clean-css`` (the plugin package) and ``make DEV=1`` needs bower.
RUN npm install -g less less-plugin-clean-css bower

# fateserver runtime: Perl CGI scripts using CGI, HTML::Entities,
# Time::Zone and URI::Escape.
RUN apt-get update && apt-get install -y --no-install-recommends \
        perl libcgi-pm-perl libhtml-parser-perl libtimedate-perl liburi-perl

# FATE sample suite snapshot (~1.4 GB), so fate tests can run without
# each container re-downloading samples. A model needing newer samples
# runs ``make fate-rsync SAMPLES=/opt/fate-suite`` (incremental).
# Path must match CONTAINER_FATE_SUITE in llm_prompt.py.
RUN rsync -a rsync://fate-suite.ffmpeg.org/fate-suite/ /opt/fate-suite/

# Interactive editor and memory debugging.  Appended as its own layer
# so the expensive FATE layer above stays cached.
RUN apt-get update && apt-get install -y --no-install-recommends \
        vim valgrind

# Full-text search over /work (source, issue/PR exports, spec PDFs).
# The index is built in the background at review start
# (pr_review_wrapper) and queried with ``recollq``; antiword and
# python3-lxml let the filters read the .doc/.docx specs in for_ffmpeg.
# The recollq wrapper (earlier on PATH than /usr/bin/recollq) blocks
# until that background build finished, so searches never see a
# half-built index.
RUN apt-get update && apt-get install -y --no-install-recommends \
        recollcmd antiword python3-lxml
COPY recoll.conf mimemap /root/.recoll/
COPY recollq /usr/local/bin/recollq

WORKDIR /work
CMD ["sleep", "infinity"]
