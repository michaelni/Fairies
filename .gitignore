# Python bytecode / compiled files
__pycache__/
*.pyc
*.pyo

/.venv/

# Wrapper debug-response dumps (one JSON per OpenAI call; rotates freely).
# Serves as the source pool for tests/fixtures/wrapper_functional_runs/*.json,
# but the raw dump directory itself is not meant to be versioned.
/openaidebug/

# Ad-hoc throwaway debug artifacts (name is literal: "delete this").
/delthis-debug/

# Git repo mirrors the review scripts clone into the workspace for
# source-bundle / vector-store use.
/ffmpeg/

# Simpast experiment run outputs (caches, per-cell logs, response
# dumps, summaries). The harness scripts are tracked; their data is not.
/simpast-runs/*
!/simpast-runs/run.sh

# Operator-prepped cutoff mirrors the simpast harness reviews against.
/simpast-mirror*/

# API keys (openai_common/anthropic_common read it; never versioned).
/.env

# Pinned codex, agy and grok binaries kept next to Containerfile.cli
# (~330 MB / ~220 MB / ~170 MB; baked into the thin images, not versioned).
/containers/codex
/containers/codex-code-mode-host
/containers/agy
/containers/grok
